# Copy to .env and fill in. All settings are PROXY_*-prefixed (see backend/app/config.py).

# REQUIRED: Fernet key that encrypts provider API keys at rest.
#   python -m app.security      (run from backend/)   or:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROXY_SECRET_KEY=

# Admin token for the UI and /admin/*. If blank, one is generated into <data_dir>/admin_token on first start.
PROXY_ADMIN_TOKEN=
# Pepper for hashing proxy keys. Changing it invalidates every issued key.
PROXY_KEY_PEPPER=change-me

# Bind address. Keep 127.0.0.1 unless a TLS reverse proxy sits in front (docs/reverse-proxy.md).
PROXY_HOST=127.0.0.1
PROXY_PORT=8000
PROXY_DATA_DIR=./data

# Policy: allow oauth_cli (consumer-subscription logins) and reusing the server user's own CLI login.
# Leave false for any deployment that serves other people. See the terms banner in the UI.
PROXY_SINGLE_USER_PERSONAL_USE=false

# Limits
PROXY_MAX_CONCURRENCY=4
PROXY_PER_USER_CONCURRENCY=2
PROXY_QUEUE_TIMEOUT_S=30
PROXY_REQUEST_TIMEOUT_S=300
PROXY_MAX_BODY_BYTES=10485760     # leaves room for base64 images; prompt text is capped separately
PROXY_MAX_IMAGE_BYTES=5242880
PROXY_MAX_IMAGES=8
PROXY_RATE_LIMIT_PER_MINUTE=60
PROXY_DEFAULT_MAX_BUDGET_USD=0.50

# Logging: prompts are NEVER logged unless this is true.
PROXY_DEBUG_LOG_PROMPTS=false

# Database. Blank = SQLite in PROXY_DATA_DIR. Postgres: install the `postgres` extra, then e.g.
#   PROXY_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/proxy
PROXY_DATABASE_URL=

# Several instances behind a load balancer: share the concurrency limits and the rate limit through Redis
# (install the `redis` extra).
PROXY_QUEUE_BACKEND=local          # local | redis
PROXY_REDIS_URL=

# GET /metrics (Prometheus). Needs the admin token as a Bearer token unless this is true.
PROXY_METRICS_PUBLIC=false

# docker compose build args
CLAUDE_CODE_VERSION=latest
# extra npm-distributed CLIs to bake into the image, e.g. "@openai/codex @google/gemini-cli"
EXTRA_NPM_CLIS=
AGY_INSTALL_CMD=
